    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
